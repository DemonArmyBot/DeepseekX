{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index" },
    { "src": "/v1/(.*)", "dest": "/api/index" },
    { "src": "/", "dest": "/api/index" },
    { "src": "/(.*)", "dest": "/api/index" }
  ]
}
